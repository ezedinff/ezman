{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EZMan",
  "version": "0.1.0",
  "identifier": "com.ezman.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EZMan",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Lightweight API client",
    "longDescription": "EZMan is a fast, lightweight desktop API client with collections, environments and scripting.",
    "copyright": "",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
