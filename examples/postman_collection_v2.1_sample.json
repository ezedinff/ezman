{
  "info": {
    "_postman_id": "c1f7a43a-8b3d-4c56-9a28-98e3b1234567",
    "name": "Sample REST API (Ezman Demo)",
    "description": "A demo Postman Collection v2.1 illustrating ezman's import, variable resolution, and warning detection capabilities.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://httpbin.org",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "ezman_test_token_12345",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{apiKey}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health & Diagnostics",
      "item": [
        {
          "name": "Get Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/status/200",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "status",
                "200"
              ]
            },
            "description": "Simple health check endpoint returning 200 OK."
          },
          "response": []
        },
        {
          "name": "Get Headers",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Client-Name",
                "value": "EzmanDesktop",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/headers?test_param=1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "headers"
              ],
              "query": [
                {
                  "key": "test_param",
                  "value": "1"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Users Management",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "console.log('Pre-request script not executed in ezman (as per lightweight design)');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Developer\",\n  \"role\": \"Engineer\",\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/post",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "post"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alice Developer\",\n  \"role\": \"Lead Architect\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/put",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "put"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/delete?id=42",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "delete"
              ],
              "query": [
                {
                  "key": "id",
                  "value": "42"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "GraphQL API",
      "item": [
        {
          "name": "Query Users",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "query GetUsers($limit: Int!) {\n  users(limit: $limit) {\n    id\n    name\n  }\n}",
                "variables": "{\n  \"limit\": 5\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create User Mutation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "mutation CreateUser($name: String!) {\n  createUser(name: $name) {\n    id\n    name\n  }\n}",
                "variables": "{\n  \"name\": \"Bob\"\n}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
        },
        {
          "name": "User Events Subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "graphql",
              "graphql": {
                "query": "subscription OnUserAdded {\n  userAdded {\n    id\n    name\n  }\n}",
                "variables": "{}"
              }
            },
            "url": {
              "raw": "{{baseUrl}}/graphql",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "graphql"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
